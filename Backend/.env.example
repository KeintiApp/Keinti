# Example environment variables for Keinti Backend
# Copy to .env and fill with real values (do NOT commit .env)

PORT=3000
POST_TTL_MINUTES=1440

# Database (Supabase Postgres recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DB_SSL=true

# JWT
JWT_SECRET=replace_me

# Upload paths
UPLOAD_PATH=./uploads
PROFILE_PHOTOS_PATH=./uploads/profile_photos

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=replace_me_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
SUPABASE_STORAGE_BUCKET=keinti_media

# Email sending via Resend (HTTP API – works on Render, no SMTP needed)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Keinti <auth@oficial.keintiapp.com>

# Google Places (server-side proxy for the mobile app; do NOT expose in the client)
GOOGLE_PLACES_API_KEY=replace_me

# Google Cloud Vision (Paso 1 de Autenticación de la cuenta)
# Puedes usar credenciales por fichero (GOOGLE_APPLICATION_CREDENTIALS) o inline.
GOOGLE_CLOUD_VISION_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_CLOUD_CLIENT_EMAIL=vision-service-account@your-project.iam.gserviceaccount.com
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa inline en un solo valor JSON:
# GOOGLE_CLOUD_VISION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# Ajustes del analizador automático de selfies
ACCOUNT_SELFIE_GCV_TIMEOUT_MS=8000
ACCOUNT_SELFIE_GCV_MIN_FACE_CONFIDENCE=0.82
ACCOUNT_SELFIE_GCV_MIN_LANDMARK_CONFIDENCE=0.70
ACCOUNT_SELFIE_GCV_MIN_FACE_AREA_RATIO=0.12
ACCOUNT_SELFIE_GCV_AUTO_FAIL_FACE_AREA_RATIO=0.05
